<!DOCTYPE html>
<html lang="ja" class="h-full antialiased">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="住居表示-住居マスター（mt_rsdtdsp_rsdt）の検索・編集・削除">
    <title>{% block title %}ABR 住居マスター{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono&family=Noto+Sans+JP:wght@400;500;700&display=swap">
    {# JS と CSS（assets/app.js から読む）。AssetMapper が importmap を出すので、Node.js でのビルドは要らない #}
    {% block javascripts %}{{ importmap('app') }}{% endblock %}
</head>
<body class="flex min-h-full flex-col font-sans">
    <header class="border-b border-white/10 bg-slate-950/40 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center gap-3 px-4 py-4 sm:px-6">
            <a href="{{ path('rsdts_index') }}" class="group flex items-center gap-3">
                <span class="grid size-8 place-items-center rounded-lg bg-gradient-to-br from-slate-200 to-slate-400 text-sm font-bold text-slate-950 shadow-lg shadow-slate-400/20">S</span>
                <span class="font-semibold tracking-wide text-slate-100 group-hover:text-white">ABR 住居マスター</span>
            </a>
            {# DB 検索と Elasticsearch 検索の切り替え #}
            <nav class="ml-6 flex gap-1 text-sm">
                {% for item in [{label: 'DB 検索', route: 'rsdts_index'}, {label: 'Elasticsearch 検索', route: 'rsdts_es'}] %}
                    <a href="{{ path(item.route) }}" class="rounded-lg px-3 py-1.5 {{ app.current_route == item.route ? 'bg-white/10 font-medium text-white' : 'text-slate-400 hover:bg-white/5 hover:text-white' }}">{{ item.label }}</a>
                {% endfor %}
            </nav>
            <span class="ml-auto rounded-full border border-white/10 px-2.5 py-0.5 font-mono text-xs text-slate-400">mt_rsdtdsp_rsdt</span>
        </div>
    </header>

    {{ include('_flash.html.twig') }}

    <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 sm:px-6">
        {% block body %}{% endblock %}
    </main>
    <footer class="py-6 text-center text-xs text-slate-500">Symfony + Doctrine + Tailwind CSS + Stimulus</footer>
</body>
</html>
